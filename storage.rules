rules_version = '2';

// Network.Ai — single-user app. Mirrors firestore.rules: every object lives
// under /users/{userId}, and the only email allowed to read or write
// anything is the one below. See firestore.rules for the full rationale.
service firebase.storage {
  match /b/{bucket}/o {

    function isOwner() {
      return request.auth != null
        && request.auth.token.email == 'girwandhakal@gmail.com'
        && request.auth.token.email_verified == true;
    }

    match /users/{userId}/{allPaths=**} {
      allow read, write: if isOwner() && request.auth.uid == userId;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
