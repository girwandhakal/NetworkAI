{
  "name": "network-ai",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "AI career-fair networking memory assistant",
  "scripts": {
    "dev": "concurrently -n server,web -c magenta,green \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "node --watch server/index.js",
    "dev:web": "vite",
    "build": "tsc -b && vite build",
    "start": "cross-env NODE_ENV=production node server/index.js",
    "preview": "vite preview",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^4.22.2",
    "firebase": "^12.18.0",
    "firebase-admin": "^14.3.0",
    "nodemailer": "^7.0.13",
    "pdfjs-dist": "^6.2.108",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6"
  },
  "devDependencies": {
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.4",
    "cross-env": "^7.0.3",
    "typescript": "^5.9.3",
    "vite": "^6.4.3"
  }
}
